        "crates/engine_audio/src/playback/system.rs::play_sound_system drains PlaySound events, applies mixer and spatial gains, and calls AudioRes",
        "crates/engine_audio/tests/suite/playback_system.rs::integration tests cover backend calls, event draining, mixer forwarding, and spatial gain behavior"
      ],
      "consumers": [
        "crates/axiom2d/src/default_plugins.rs",
        "crates/axiom2d/tests/suite/default_plugins.rs",
        "crates/engine_audio/tests/suite/playback_system.rs"
      ],
      "dependencies": [
        "EventBus<PlaySound>",
        "SoundLibrary",
        "MixerState",
        "AudioRes",
        "AudioBackend"
      ]
    },
    {
      "name": "provide backend-independent audio data and control types",
      "currentOwners": [
        "crates/engine_audio/src/backend/traits.rs::AudioBackend and NullAudioBackend",
        "crates/engine_audio/src/audio_res.rs::AudioRes",
        "crates/engine_audio/src/sound/{data,effect,library}.rs::sound data, synthesis, and lookup",
        "crates/engine_audio/src/mixer.rs::MixerTrack and MixerState"
      ],
      "consumers": [
        "crates/engine_audio/src/backend/cpal.rs",
        "crates/engine_audio/src/playback/system.rs",
        "crates/axiom2d/src/default_plugins.rs",
        "crates/engine_audio/tests"
      ],
      "dependencies": [
        "cpal",
        "fundsp",
        "bevy_ecs",
        "engine_core"
      ]
    },
    {
      "name": "compute and apply spatial audio gains",
      "currentOwners": [
        "crates/engine_audio/src/spatial.rs::spatial components, gain math, and ECS system",
        "crates/engine_audio/src/playback/buffer.rs::SpatialGains carried on PlaySound"
      ],
      "consumers": [
        "crates/axiom2d/src/default_plugins.rs",
        "crates/engine_audio/src/playback/system.rs",
        "crates/engine_audio/tests/suite/spatial.rs",
        "crates/engine_audio/tests/suite/playback_system.rs"
      ],
      "dependencies": [
        "GlobalTransform2D",
        "EventBus<PlaySound>",
        "AudioEmitter",
        "AudioListener"
      ]
    }
  ],
  "desired": {
    "ownership": [],
    "boundaries": []
  }
}
