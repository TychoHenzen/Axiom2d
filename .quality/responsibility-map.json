      },
      {
        "responsibility": "run the image conversion GUI and preview workflow",
        "owner": "tools/img-to-shape-gui/src/main.rs"
      },
      {
        "responsibility": "convert Tiled TSX tilesets into terrain code",
        "owner": "tools/tiled-to-shapes/src/pipeline.rs"
      },
      {
        "responsibility": "parse Cargo test output into living documentation",
        "owner": "tools/living-docs/src/lib.rs"
      }
    ],
    "boundaries": [
      {
        "from": "convert source images into engine shapes",
        "to": "generate exported Rust shape modules and persist manifests",
        "allowed": true
      },
      {
        "from": "generate exported Rust shape modules and persist manifests",
        "to": "run the image conversion GUI and preview workflow",
        "allowed": true
      },
      {
        "from": "convert source images into engine shapes",
        "to": "run the image conversion GUI and preview workflow",
        "allowed": true
      },
      {
        "from": "convert source images into engine shapes",
        "to": "convert Tiled TSX tilesets into terrain code",
        "allowed": true
      }
    ]
  }
