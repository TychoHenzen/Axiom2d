    },
    {
      "name": "convert Tiled TSX tilesets into terrain code",
      "currentOwners": [
        "tools/tiled-to-shapes/src/pipeline.rs",
        "tools/tiled-to-shapes/src/tsx_parser.rs",
        "tools/tiled-to-shapes/src/extract.rs",
        "tools/tiled-to-shapes/src/normalize.rs",
        "tools/tiled-to-shapes/src/scaffold.rs",
        "tools/tiled-to-shapes/src/codegen.rs",
        "tools/tiled-to-shapes/src/types.rs"
      ],
      "consumers": [
        "tools/tiled-to-shapes/src/main.rs",
        "tools/tiled-to-shapes/tests/suite/integration.rs",
        "tools/tiled-to-shapes/tests/suite/pipeline.rs",
        "tools/tiled-to-shapes/tests/suite/parse_tsx.rs"
      ],
      "dependencies": [
        "quick-xml TSX parsing",
        "img-to-shape conversion APIs",
        "terrain and engine_render generated code contracts"
      ]
    },
    {
      "name": "parse Cargo test output into living documentation",
      "currentOwners": [
        "tools/living-docs/src/lib.rs",
        "tools/living-docs/src/main.rs"
      ],
      "consumers": [
        "tools/living-docs/src/main.rs::main",
        "tools/living-docs/tests/lib.rs"
      ],
      "dependencies": [
        "Cargo test output format",
        "filesystem source locations",
        "Markdown rendering conventions"
