{
  "targetScope": [
    "crates/engine_ecs"
  ],
  "responsibilities": [
    {
      "name": "re-export the shared ECS surface",
      "currentOwners": [
        "crates/engine_ecs/src/prelude.rs::bevy_ecs type and schedule re-exports define the supported convenience surface",
        "crates/engine_ecs/src/lib.rs::module declarations expose prelude and schedule"
      ],
      "consumers": [
        "crates/engine_app",
        "crates/axiom2d",
        "crates/card_game",
        "crates/demo",
        "crates/terrain_viewer",
        "crates/engine_ecs/tests/schedule.rs"
      ],
      "dependencies": [
        "bevy_ecs::prelude",
        "bevy_ecs::schedule::IntoScheduleConfigs",
        "bevy_ecs::system::ScheduleSystem"
      ]
    },
    {
      "name": "define canonical engine schedule phases",
      "currentOwners": [
        "crates/engine_ecs/src/schedule.rs::Phase owns the 18 ScheduleLabel variants, declaration indices, and names",
        "crates/engine_ecs/src/schedule.rs::PHASE_COUNT owns the fixed schedule-array size",
        "crates/engine_ecs/tests/schedule.rs::phase contract tests pin count, order, and names"
      ],
      "consumers": [
        "crates/engine_app/src/app.rs",
        "crates/engine_app/src/phase.rs",
        "crates/axiom2d",
        "crates/card_game",
        "crates/demo",
        "crates/terrain_viewer"
      ],
      "dependencies": [
        "bevy_ecs::schedule::ScheduleLabel",
        "Phase::ALL declaration order",
        "PHASE_COUNT array sizing"
      ]
    },
    {
      "name": "pin phase ordering and naming behavior",
      "currentOwners": [
        "crates/engine_ecs/tests/schedule.rs::when_index_then_matches_declaration_order verifies index stability",
        "crates/engine_ecs/tests/schedule.rs::when_phase_count_then_equals_eighteen verifies fixed capacity",
        "crates/engine_ecs/tests/schedule.rs::when_all_phases_mapped_to_names_then_frozen_sequence verifies public names"
      ],
      "consumers": [
        "crates/engine_app schedule execution",
        "downstream crates registering systems by Phase"
      ],
      "dependencies": [
        "Phase::ALL",
        "Phase::index",
        "Phase::name"
      ]
    }
  ],
  "desired": {
    "ownership": [],
    "boundaries": []
  }
}
