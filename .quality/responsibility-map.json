        "tools/img-to-shape-gui/src/main.rs",
        "tools/img-to-shape-gui/src/state.rs",
        "tools/img-to-shape-gui/src/preview.rs",
        "tools/img-to-shape-gui/src/loader.rs"
      ],
      "consumers": [
        "tools/img-to-shape-gui/src/main.rs::main",
        "tools/img-to-shape-gui/tests/suite/state.rs",
        "tools/img-to-shape-gui/tests/suite/preview.rs",
        "tools/img-to-shape-gui/tests/suite/loader.rs"
      ],
      "dependencies": [
        "eframe and egui application runtime",
        "rfd file picker",
        "img-to-shape conversion and export APIs"
